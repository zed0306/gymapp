# Настройки бота GymApp. Скопируй в bot/.env и впиши свои значения:
#   cp bot/.env.example bot/.env && chmod 600 bot/.env   # токен — только для root
#   ln -s bot/.env .env                                  # для Docker: Caddy возьмёт отсюда PUBLIC_HOST
# Формат: ИМЯ=значение, без пробелов вокруг «=» и без кавычек. Строки с # — комментарии.
# bot/.env не коммить: в нём токен бота.

# ── Обязательно ─────────────────────────────────────────
# Токен от @BotFather (/mybots → бот → API Token)
BOT_TOKEN=123456:ABC-your-token
# Telegram ID админов через запятую — им доступны /admin и /api/admin/stats (свой ID подскажет @userinfobot)
ADMIN_IDS=1411430230

# ── Сервер для челленджей и статистики ──────────────────
# Домен сервера. Бесплатный вариант с HTTPS: IP через дефисы + .sslip.io
# (IP 203.0.113.5 → 203-0-113-5.sslip.io). Его читает Caddy и выпускает сертификат.
PUBLIC_HOST=203-0-113-5.sslip.io
# Адрес сервера снаружи (https://<PUBLIC_HOST>, без «/» в конце). Бот добавляет его
# к ссылкам мини-аппа (?api=…), чтобы приложение знало, куда слать запросы.
PUBLIC_URL=https://203-0-113-5.sslip.io

# ── Мини-апп ────────────────────────────────────────────
# Адрес мини-аппа на GitHub Pages
WEBAPP_URL=https://zed0306.github.io/gymapp/
# С каких сайтов браузеру можно обращаться к API (CORS), через запятую. Обычно — сайт мини-аппа.
ALLOWED_ORIGINS=https://zed0306.github.io

# ── Необязательно ───────────────────────────────────────
# Юзернейм бота без @ для ссылок-приглашений (t.me/<бот>?start=ch_…). Пусто — бот узнает сам.
BOT_USERNAME=
# Где слушает HTTP API. В Docker не трогай. Без Docker за Caddy на том же сервере — 127.0.0.1.
API_HOST=0.0.0.0
API_PORT=8080
# Файл базы SQLite. Пусто — bot/gymapp.db. В Docker всегда /data/gymapp.db (задано в docker-compose.yml),
# без Docker — /var/lib/gymapp/gymapp.db (задано в службе systemd, см. DEPLOY.md).
DB_PATH=
# 1 — режим разработки: API принимает запросы с http://127.0.0.1:8080 и http://localhost:8080
DEV=0
